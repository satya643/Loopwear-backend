generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  customer
  operator
  admin
}

enum Occasion {
  Wedding
  Party
  Office
  DateNight @map("Date Night")
  Festival
  Travel
  Everyday
}

enum StyleTag {
  Minimal
  Classic
  Street
  Formal
  Traditional
  Contemporary
}

enum ProductView {
  front
  back
  fabric
  model
  detail
}

// The 8 states from the Concourse frontend, plus two terminal states the
// frontend enum has no exit for:
//  - `retired`   — a unit that fails inspection permanently (build spec §7.7)
//  - `sold`      — a unit fulfilling a "buy" order leaves rental circulation
//                  for good (not covered by the original spec, but required
//                  for correctness: without it, a bought unit would still
//                  count as inventory).
enum GarmentStage {
  available
  reserved
  rented
  returned
  inspection
  laundry
  quality
  ready
  retired
  sold
}

enum Condition {
  excellent
  good
  fair
  needs_review @map("needs review")
}

enum CartMode {
  rent
  buy
}

enum OrderStatus {
  pending_payment
  confirmed
  packed
  shipped
  with_customer     @map("with customer")
  return_in_transit @map("return in transit")
  closed
  cancelled
  // Hold expired after a failed/abandoned payment attempt — stock released.
  payment_failed    @map("payment failed")
  // Fully refunded (customer/operator cancel after payment, or a late
  // payment that arrived after the order's stock was released).
  refunded
}

enum PaymentMethod {
  card
  wallet
  bank_transfer
  upi
  netbanking
  other
}

enum PaymentStatus {
  pending
  paid
  partially_refunded
  refunded
  failed
}

enum PaymentGateway {
  stripe
  razorpay
  mock
}

enum RefundStatus {
  pending
  processed
  failed
}

enum LaundryStage {
  received
  washing
  drying
  pressing
  quality
  ready
}

enum LaundryPriority {
  standard
  rush
}

enum DeliveryType {
  pickup
  dropoff
}

enum DeliveryStatus {
  scheduled
  en_route
  completed
  delayed
}

enum DiscountType {
  percent
  flat
}

enum OrderEventType {
  order_created
  payment_initiated
  payment_failed
  payment_cancelled
  payment_succeeded
  status_changed
  order_cancelled
  order_expired
  refund_initiated
  refunded
  note
}

enum OrderActor {
  customer
  system
  operator
  gateway
}

enum WebhookEventStatus {
  received
  processed
  ignored
  failed
}

enum NotificationSeverity {
  info
  warning
  danger
  success
}

enum RelatedType {
  order
  batch
  delivery
  unit
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  phone             String?  @unique
  // Nullable: Google-only accounts (created via continueWithGoogle) have no
  // password of their own.
  passwordHash      String?
  googleId          String?  @unique
  verified          Boolean  @default(false)
  role              Role     @default(customer)
  // Multi-currency (build spec §currency decisions): country drives the
  // default display currency; preferredCurrency lets a signed-in user override it.
  country           String?
  preferredCurrency String?
  createdAt         DateTime @default(now())

  cart                Cart?
  wishlistItems       WishlistItem[]
  orders              Order[]              @relation("CustomerOrders")
  payments            Payment[]
  sessions            Session[]
  stageTransitions    StageTransition[]    @relation("StageTransitionActor")
  reviews             Review[]
  notificationReads   NotificationRead[]
  passwordResetTokens PasswordResetToken[]
  addresses           Address[]
  couponRedemptions   CouponRedemption[]
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?

  @@index([userId])
}

model OtpCode {
  phone           String   @id
  codeHash        String
  expiresAt       DateTime
  attempts        Int      @default(0)
  lastSentAt      DateTime @default(now())
  sendCount       Int      @default(0)
  sendWindowStart DateTime @default(now())
}

// One-time password-reset link, delivered by email. tokenHash is a SHA-256
// digest of the raw token sent to the user — unlike bcrypt, SHA-256 is
// deterministic, so we can look the record up directly by hash without
// needing a separate identifier alongside the token.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalog (Shop) vs Inventory (Concourse) — kept as two separate tables.
// See build spec §2: a Product is a design, a GarmentUnit is one physical item.
// ---------------------------------------------------------------------------

// Single source of truth for categories — the admin panel's dropdown and
// the shop's category navigation both read this same table (never two
// separate lists to keep in sync). Managed via the console, not hardcoded.
model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id             String     @id @default(uuid())
  name           String
  brand          String
  categoryId     String
  category       Category   @relation(fields: [categoryId], references: [id])
  occasions      Occasion[]
  styles         StyleTag[]
  rentPricePaise Int
  rentDays       Int
  buyPricePaise  Int
  depositPaise   Int
  deliveryDays   Int
  fabric         String
  care           String[]
  measurements   Json
  // Free-text product write-up (the shop's "details" copy) — separate from
  // `fabric`/`care`/`measurements`, which are each their own structured
  // field. Empty string, not null, so every consumer can render it directly.
  description    String     @default("")
  // One admin-uploaded thumbnail shown on cards/cart lines before any color
  // is picked (or when a color has no photo of its own yet) — see
  // ProductVariant.imageUrls for the per-color photos that take priority
  // over this once a customer selects a color.
  coverImageUrl  String?
  // Per-product condition/quality blurb shown on the PDP — was a single
  // hardcoded string for every product ("Excellent condition, inspected
  // before dispatch"); now admin-settable, defaulting to that same copy so
  // existing products render unchanged until an admin customizes it.
  conditionCopy  String     @default("Excellent condition, inspected before dispatch")
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  variants       ProductVariant[]
  reviews        Review[]
  outfitProducts OutfitProduct[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]

  @@index([categoryId])
}

// One row per color a Product comes in. Product = the design ("Premium
// Linen Shirt"); ProductVariant = one color of it ("Black"); GarmentUnit =
// one physical item of a (variant, size). Color/colorHex/images/views moved
// here from Product — a product with 3 colors is one Product row with 3
// ProductVariant rows, never 3 separate Products.
model ProductVariant {
  id        String        @id @default(uuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String
  colorHex  String
  views     ProductView[]
  imageUrls Json          @default("{}")
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  sizes        VariantSize[]
  garmentUnits GarmentUnit[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@unique([productId, color])
}

// Declares which sizes a variant is offered in — catalog metadata for the
// admin's size checkboxes, not a stock count. Real stock is always
// `count(GarmentUnit where variantId=X, size=Y, stage=available)`; a
// separate counter here would just drift out of sync with it.
model VariantSize {
  id        String         @id @default(uuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  size      String

  @@unique([variantId, size])
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([productId])
}

model Facility {
  id             String         @id @default(uuid())
  name           String
  city           String
  garmentUnits   GarmentUnit[]
  laundryBatches LaundryBatch[]
}

model GarmentUnit {
  id             String         @id @default(uuid())
  sku            String         @unique
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  size           String
  stage          GarmentStage   @default(available)
  condition      Condition      @default(excellent)
  retiredAt      DateTime?
  lastMovedAt    DateTime       @default(now())
  timesRented    Int            @default(0)
  currentOrderId String?
  currentOrder   Order?         @relation("OrderCurrentUnits", fields: [currentOrderId], references: [id])
  facilityId     String?
  facility       Facility?      @relation(fields: [facilityId], references: [id])

  stageTransitions StageTransition[]
  batchItems       BatchItem[]
  orderItems       OrderItem[]

  @@index([variantId, size, stage])
  @@index([stage])
}

model StageTransition {
  id            String        @id @default(uuid())
  garmentUnitId String
  garmentUnit   GarmentUnit   @relation(fields: [garmentUnitId], references: [id], onDelete: Cascade)
  fromStage     GarmentStage?
  toStage       GarmentStage
  actorUserId   String?
  actor         User?         @relation("StageTransitionActor", fields: [actorUserId], references: [id])
  occurredAt    DateTime      @default(now())
  note          String?

  @@index([garmentUnitId])
}

model Outfit {
  id                 String   @id @default(uuid())
  name               String
  occasion           Occasion
  lookRentPricePaise Int
  lookBuyPricePaise  Int
  lookRentDays       Int

  outfitProducts OutfitProduct[]
}

model OutfitProduct {
  outfitId  String
  outfit    Outfit  @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  position  Int     @default(0)

  @@id([outfitId, productId])
}

// The admin-uploaded cover image + blurb for one occasion's tile on the
// shop's "Shop by Occasion" home section (see console/occasionTiles and
// catalog's getOccasionsWithCounts). One row per Occasion at most — not a
// generic list an admin builds, so `occasion` is the primary key rather
// than a separate uuid + unique constraint. No row yet for a given occasion
// means the admin hasn't set an image for it, and the shop hides that tile
// rather than falling back to placeholder/stock imagery.
model OccasionTile {
  occasion  Occasion @id
  imageUrl  String
  blurb     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Cart & Wishlist (persistent — closes build spec §7.3)
// ---------------------------------------------------------------------------

model Cart {
  id         String     @id @default(uuid())
  userId     String     @unique
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Code the customer applied — re-evaluated on every cart read, never a
  // stored discount amount (see modules/coupons).
  couponCode String?
  createdAt  DateTime   @default(now())
  items      CartItem[]
}

model CartItem {
  id                     String         @id @default(uuid())
  cartId                 String
  cart                   Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId              String
  product                Product        @relation(fields: [productId], references: [id])
  // The colour chosen. Stock is per (variant, size), never per product.
  variantId              String
  variant                ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  mode                   CartMode
  size                   String
  quantity               Int            @default(1)
  startDate              DateTime?
  // Price the customer saw when the line was added/last revalidated — only
  // used to tell them "price changed", never to charge (the DB price is).
  unitPricePaiseSnapshot Int?
  depositPaiseSnapshot   Int?
  addedAt                DateTime       @default(now())
  updatedAt              DateTime       @default(now()) @updatedAt

  // Adding the same (colour, size, mode) again updates that line.
  @@unique([cartId, variantId, size, mode])
}

model WishlistItem {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  addedAt   DateTime @default(now())

  @@id([userId, productId])
}

// ---------------------------------------------------------------------------
// Orders / Payments / Refunds
// ---------------------------------------------------------------------------

model Order {
  id                   String      @id
  customerId           String
  customer             User        @relation("CustomerOrders", fields: [customerId], references: [id])
  placedAt             DateTime    @default(now())
  eventDate            DateTime?
  status               OrderStatus @default(pending_payment)
  city                 String?
  // Shipping/delivery address — the checkout request body already carried
  // this (frontend's `DeliveryDetails`) but nothing on the backend accepted
  // or stored it, so every order was placed with no address to ship to at all.
  deliveryName         String?
  deliveryEmail        String?
  deliveryPhone        String?
  deliveryAddressLine1 String?
  deliveryAddressLine2 String?
  deliveryState        String?
  deliveryPostalCode   String?
  deliveryCountry      String?
  deliveryNote         String?
  // Currency the customer was actually charged in, plus the FX rate applied
  // at order time (audit trail) — canonical accounting stays in base currency.
  currency             String      @default("INR")
  fxRateToBase         Float       @default(1.0)
  // Price breakdown, all base-currency paise, all computed server-side:
  //   totalPaise = subtotalPaise - discountPaise + deliveryFeePaise
  //   amount charged = totalPaise + depositTotalPaise
  subtotalPaise        Int         @default(0)
  discountPaise        Int         @default(0)
  deliveryFeePaise     Int         @default(0)
  totalPaise           Int
  depositTotalPaise    Int
  couponId             String?
  coupon               Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode           String?
  // The saved address used; the delivery* columns above are the snapshot
  // that actually drives fulfilment (the address can be edited/deleted later).
  addressId            String?
  address              Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  deliveryMethod       String?
  deliveryMethodLabel  String?
  deliveryEtaMinDays   Int?
  deliveryEtaMaxDays   Int?
  // Unpaid orders hold stock until this moment (see jobs/releaseAbandonedReservations).
  paymentExpiresAt     DateTime?
  // Hash of items + address + method + coupon + total — lets a repeated
  // "place order" for the same checkout return the same unpaid order.
  checkoutFingerprint  String?
  // Cart lines this order was built from; removed from the cart only once
  // payment is confirmed.
  sourceCartItemIds    String[]    @default([])
  confirmedAt          DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  createdVia           String      @default("shop")
  idempotencyKey       String?     @unique
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @default(now()) @updatedAt

  items            OrderItem[]
  payments         Payment[]
  deliveryJobs     DeliveryJob[]
  garmentUnits     GarmentUnit[]     @relation("OrderCurrentUnits")
  events           OrderEvent[]
  refunds          Refund[]
  couponRedemption CouponRedemption?

  @@index([customerId])
  @@index([status])
  @@index([customerId, status])
  @@index([status, paymentExpiresAt])
}

model OrderItem {
  id               String          @id @default(uuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Snapshots at purchase time — the order must read the same even if the
  // product is renamed, recoloured or deleted later.
  productName      String?
  color            String?
  imageUrl         String?
  garmentUnitId    String?
  garmentUnit      GarmentUnit?    @relation(fields: [garmentUnitId], references: [id])
  mode             CartMode
  size             String
  // One row per physical unit, so quantity is implicit (the API groups rows).
  unitPricePaise   Int
  depositPaise     Int
  rentDays         Int?
  rentStartDate    DateTime?
  rentReturnDate   DateTime?
  actualReturnDate DateTime?

  refunds Refund[]

  @@index([orderId])
  @@index([garmentUnitId])
}

// NOTE: a hand-written migration (20260919000000_payment_active_unique_per_order)
// also adds a partial unique index on (orderId) WHERE status IN ('pending','paid')
// — not representable in this DSL — so only one active payment can ever exist
// per order at the DB level. Don't let a future `prisma migrate dev` diff drop it.
model Payment {
  id                 String         @id @default(uuid())
  orderId            String
  order              Order          @relation(fields: [orderId], references: [id])
  customerId         String
  customer           User           @relation(fields: [customerId], references: [id])
  amountPaise        Int
  chargedAmountMinor Int
  chargedCurrency    String
  method             PaymentMethod
  status             PaymentStatus  @default(pending)
  gateway            PaymentGateway @default(stripe)
  gatewayRef         String?        @unique
  // Only used for gateways where the charge id differs from gatewayRef (e.g.
  // Razorpay: gatewayRef holds the order id, this holds the payment id that
  // refunds must reference). Null for Stripe, where gatewayRef IS the
  // refundable id (the PaymentIntent).
  gatewayPaymentRef  String?
  idempotencyKey     String?        @unique
  // Last failed attempt on this gateway order (Razorpay lets the customer
  // retry the same order, so a failure doesn't end the payment).
  failureCode        String?
  failureReason      String?
  paidAt             DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @default(now()) @updatedAt

  refunds Refund[]

  @@index([orderId])
  @@index([customerId])
}

// Either a per-item refund (rental deposit, orderItemId set) or a whole-order
// refund (cancellation / late payment, orderId set).
model Refund {
  id          String       @id @default(uuid())
  orderItemId String?
  orderItem   OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  orderId     String?
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId   String?
  payment     Payment?     @relation(fields: [paymentId], references: [id])
  amountPaise Int
  reason      String
  status      RefundStatus @default(pending)
  gatewayRef  String?
  actorUserId String?
  createdAt   DateTime     @default(now())
  processedAt DateTime?
}

// ---------------------------------------------------------------------------
// Addresses, coupons, order history, webhook log
// ---------------------------------------------------------------------------

// Customer address book. One default per user is enforced by a partial
// unique index (hand-written in the migration — not expressible here).
model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("Home")
  fullName   String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  postalCode String
  country    String   @default("IN")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[]

  @@index([userId])
}

model Coupon {
  id               String       @id @default(uuid())
  // Always stored upper-case; lookups normalise the input the same way.
  code             String       @unique
  description      String       @default("")
  type             DiscountType
  // percent: 1-100; flat: paise.
  value            Int
  maxDiscountPaise Int?
  minSubtotalPaise Int          @default(0)
  // null = applies to every line; otherwise only rent or only buy lines.
  appliesTo        CartMode?
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  perUserLimit     Int?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  redemptions CouponRedemption[]
  orders      Order[]
}

// Written only when an order's payment is confirmed — this is what usage
// limits count, so abandoned checkouts never burn a customer's coupon.
model CouponRedemption {
  id            String   @id @default(uuid())
  couponId      String
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountPaise Int
  createdAt     DateTime @default(now())

  @@index([couponId])
  @@index([userId, couponId])
}

// Append-only order history — the customer's tracking timeline and the
// console's audit trail are both read from here.
model OrderEvent {
  id          String         @id @default(uuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        OrderEventType
  // Order status after this event, when the event changed it.
  status      OrderStatus?
  message     String
  actor       OrderActor
  actorUserId String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([orderId, createdAt])
}

// Every gateway webhook delivery, keyed by the provider's event id, so a
// redelivered event is recognised and never processed twice.
model WebhookEvent {
  id          String             @id @default(uuid())
  provider    String
  eventId     String
  eventType   String
  payload     Json
  status      WebhookEventStatus @default(received)
  attempts    Int                @default(1)
  error       String?
  receivedAt  DateTime           @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
}

// ---------------------------------------------------------------------------
// Laundry
// ---------------------------------------------------------------------------

model LaundryBatch {
  id                  String          @id @default(uuid())
  facilityId          String
  facility            Facility        @relation(fields: [facilityId], references: [id])
  stage               LaundryStage    @default(received)
  priority            LaundryPriority @default(standard)
  startedAt           DateTime        @default(now())
  estimatedCompleteAt DateTime

  items BatchItem[]
}

model BatchItem {
  batchId       String
  batch         LaundryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  garmentUnitId String
  garmentUnit   GarmentUnit  @relation(fields: [garmentUnitId], references: [id])

  @@id([batchId, garmentUnitId])
}

// ---------------------------------------------------------------------------
// Delivery
// ---------------------------------------------------------------------------

model Courier {
  id    String   @id @default(uuid())
  name  String
  zones String[]

  deliveryJobs DeliveryJob[]
}

model DeliveryJob {
  id          String         @id @default(uuid())
  type        DeliveryType
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id])
  windowStart DateTime
  windowEnd   DateTime
  zone        String
  courierId   String?
  courier     Courier?       @relation(fields: [courierId], references: [id])
  status      DeliveryStatus @default(scheduled)

  @@index([orderId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Notifications (per-user read state — closes build spec §7.11)
// ---------------------------------------------------------------------------

model Notification {
  id          String               @id @default(uuid())
  severity    NotificationSeverity
  title       String
  detail      String
  relatedType RelatedType
  relatedId   String
  createdAt   DateTime             @default(now())

  reads NotificationRead[]
}

model NotificationRead {
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([notificationId, userId])
}

// ---------------------------------------------------------------------------
// Analytics & Currency
// ---------------------------------------------------------------------------

model DailyMetric {
  id         String   @id @default(uuid())
  date       DateTime @db.Date
  metricName String
  value      Float

  @@unique([date, metricName])
}

model FxRate {
  baseCurrency   String
  targetCurrency String
  rate           Float
  updatedAt      DateTime @default(now())

  @@id([baseCurrency, targetCurrency])
}
