# --- Currency / FX ---
# Base currency all prices are stored in (integer minor units, e.g. paise for INR)
BASE_CURRENCY="INR"
# Optional: API key for a live FX rate provider (e.g. exchangerate.host / openexchangerates).
# If unset, the fxRates job keeps the last seeded/fetched rates in daily_metrics-style storage.
FX_RATE_API_KEY=
FX_RATE_API_URL="https://api.exchangerate.host/latest"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_AUTH_REQUESTS=20
RATE_LIMIT_MAX_GENERAL_REQUESTS=300

# --- Google sign-in ---
# Client ID of the Google OAuth app; used as the audience when verifying
# ID tokens sent by the frontend. Not a secret, but must match the frontend's
# client ID. Leave blank to keep /auth/google disabled.
GOOGLE_CLIENT_ID=""
