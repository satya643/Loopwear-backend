# --- Database ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/everyOccasion?schema=public"

# --- Server ---
# PORT=4000
# NODE_ENV=development
# APP_BASE_URL="http://localhost:4000"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-secret"
JWT_TTL_DAYS=7

# --- OTP ---
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_DAILY_SEND_CAP=5

# --- SMS provider: Twilio (leave blank to log OTPs to console in dev) ---
SMS_PROVIDER_API_KEY=twilio
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# Twilio phone number to send OTPs from, e.g. "+15551234567"
TWILIO_FROM_NUMBER=

# --- Stripe (international card payments) ---
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# --- Razorpay (INR payments / UPI / cards) ---
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
# Optional: only needed if you configure a webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=

# --- Currency / FX ---
# Base currency all prices are stored in (integer minor units, e.g. paise for INR)
BASE_CURRENCY="INR"
# Optional: API key for a live FX rate provider (e.g. exchangerate.host / openexchangerates).
# If unset, the fxRates job keeps the last seeded/fetched rates in daily_metrics-style storage.
FX_RATE_API_KEY=
FX_RATE_API_URL="https://api.exchangerate.host/latest"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_AUTH_REQUESTS=20

# --- Google sign-in ---
# Client ID of the Google OAuth app; used as the audience when verifying
# ID tokens sent by the frontend. Not a secret, but must match the frontend's
# client ID. Leave blank to keep /auth/google disabled.
GOOGLE_CLIENT_ID=""
