# --- Database ---
# YourNew@&$12345678Password
DATABASE_URL="postgresql://postgres:YourNew@&$12345678Password@localhost:5432/everyOccasion?schema=public"
# --- Server ---
# PORT=4000
# NODE_ENV=development
# APP_BASE_URL="http://localhost:4000"s

# --- OTP ---
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_DAILY_SEND_CAP=5

# --- SMS provider (plug in a real provider; leave blank to log OTPs to console in dev) ---
SMS_PROVIDER_API_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# --- Currency / FX ---
# Base currency all prices are stored in (integer minor units, e.g. paise for INR)
BASE_CURRENCY="INR"
# Optional: API key for a live FX rate provider (e.g. exchangerate.host / openexchangerates).
# If unset, the fxRates job keeps the last seeded/fetched rates in daily_metrics-style storage.
FX_RATE_API_KEY=
FX_RATE_API_URL="https://api.exchangerate.host/latest"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_AUTH_REQUESTS=20

# --- Google sign-in ---
# Client ID of the Google OAuth app; used as the audience when verifying
# ID tokens sent by the frontend. Not a secret, but must match the frontend's
# client ID. Leave blank to keep /auth/google disabled.
GOOGLE_CLIENT_ID="970544688309-74r2immevd8cluhe6p492pgdogm9qjld.apps.googleusercontent.com"
